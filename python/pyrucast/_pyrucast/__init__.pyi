        # Returns
        
        A new field of the type of `field`, with the same structure.
        
        # Raises
        
        `TypeError` if `field` is none of the four field types.
        """
    def select(self, ge: typing.Optional[builtins.float] = None, gt: typing.Optional[builtins.float] = None, le: typing.Optional[builtins.float] = None, lt: typing.Optional[builtins.float] = None, components: typing.Optional[typing.Sequence[builtins.str]] = None) -> Mesh:
        r"""
        Select the **nodes** of this field passing a value band, zone by zone —
        a value-range filter returning a `Mesh` with one POI1 submesh per
        processed zone.
        
        The band is set by the four comparison bounds — `ge` (`≥`), `gt` (`>`),
        `le` (`≤`), `lt` (`<`); give at most one lower (`ge`/`gt`) and one upper
        (`le`/`lt`), at least one overall. With several components in play they
        are combined with **AND**: a node is kept only when *every* tested
        component is in band.
        
        `components=None` tests every component of each zone. A `components`
        list tests **only** those components, and only on the zones carrying
        **all** of them — a zone missing any listed component is skipped (no
        submesh). Errors if no bound is given, or the lower one exceeds the upper.
        """
    def restrict(self, mesh: Mesh) -> NodeField:
        r"""
        Restrict `field` to the nodes of `mesh`, keeping the components found there.
        
        Each zone of the result lies on the POI1 companion of a submesh of `mesh` — its
        distinct nodes, built once and kept with the submesh. Two restrictions onto
        the **same** `mesh` share that support, so they combine directly:
        `restrict(a, mesh) - restrict(b, mesh)` is the node-by-node difference.
        That support is also the one a stiffness block over `mesh` uses, so
        `K * restrict(f, mesh)` and `solve(K, f) - restrict(g, mesh)` line up too.
        
        A zone takes the components of the zones of `field` that hold at least one
        of its nodes: a zone of `field` sharing no node with the submesh adds
        nothing to it. The test is on the nodes, not on the values: a component
        that is `0.0` everywhere stays.
        
        Element operations on the region (`gradient`, `integral`, `deformation`,
        `interp_to_gauss`) take `mesh` as a separate argument and read the field by
        node. To land on every support of an existing field `a`, with its
        components, take `pyrucast.node_field.restrict_like`: `restrict(field,
        a.support())` keeps the components of `field`, and leaves out a support
        sharing no node with it.
        
        # Parameters
        
        - `field`: the field to restrict.
        - `mesh`: the region.
        
        # Returns
        
        A new `NodeField` with at most one zone per submesh of `mesh`, each submesh
        once (one listed twice gives one zone); a submesh sharing no node with
        `field` gives none. A node of `mesh` a zone of `field` does not define gets
        `0.0` for its components; the nodes outside `mesh` are dropped. An empty
        field carries no component, and gives an empty field, as with
        `restrict_like`. A `mesh` on another `Coords` shares no node with `field`,
        and gives an empty field too.
        """
    def project(self, mesh: Mesh, target: Mesh, tol: builtins.float = 1e-06) -> NodeField:
        r"""
        This nodal field interpolated by the cells of `mesh` at the nodes of
        `target`: a node of `target` inside a cell of `mesh` takes `Σ Nᵢ(ξ)
        f(nodeᵢ)`, the shape functions of that cell at the node (quadratic cells
        interpolate quadratically); every component is carried. A node of `target`
        outside `mesh` — farther than `tol` outside every cell's reference element
        — gets zero. Read first zone first, a node of `mesh` the field does not
        define reading zero. `mesh` and `target` may live in different `Coords`.
        One zone per submesh of `target`. Errors: the field and `mesh` on
        different `Coords`; `mesh` and `target` in different dimensions.
        """
    def restrict_like(self, target: NodeField) -> NodeField:
        r"""
        Read `field` on the supports **and the components** of `target`.
        
        Zone by zone of `target`, `field` is read as `pyrucast.node_field.restrict`
        reads it, on the zone's support and with the zone's components: those
        `target` lacks are dropped, those no zone of `field` gives at its nodes are
        created at `0.0`. Every zone of `target` gets its zone, where
        `restrict(field, target.support())` keeps the components of `field` and
        leaves out a support sharing no node with it.
        
        Taking the components of `target` too is what lets the result combine with
        `target` directly by the arithmetic operators, whatever its zones. A field
        from `pyrucast.solver.solve` has one zone per block, the zones meeting at
        shared nodes with a part of the components each: with the components of
        `field`, a component would land in a zone where `target` lacks it, pass
        through unchanged there while another zone sums it at the same node, and
        the operation would refuse the two values. The typical use folds an
        increment from `solve`, which also carries the multipliers, into a current
        solution (`target + restrict_like(du, target)`).
        
        # Parameters
        
        - `field`: the field to read.
        - `target`: the field whose zones, supports and components the result
          takes.
        
        # Returns
        
        A new `NodeField` zone for zone like `target`. A `(node, component)` pair
        takes the value of `field` when it defines it, `0.0` otherwise; the nodes
        and components of `field` absent from `target` are dropped. An empty field
        gives an empty field, as with `restrict`. A `target` on another `Coords`
        shares no node with `field`: its zones are all `0.0`.
        """
    def consolidate(self) -> NodeField:
        r"""
        Fuse the zones of `field` that lie on the same support into one.
        
        The zones on one support become a single zone carrying the union of their
        components; zones on distinct supports stay side by side. The union `a | b`
        and `pyrucast.node_field.merge` end with this step.
        
        # Parameters
        
        - `field`: the field to consolidate.
        
        # Returns
        
        A new `NodeField`; `field` itself is left untouched.
        
        # Raises
        
        `RuntimeError` if two zones disagree on a value at a shared
        `(node, component)` pair.
        """
    def mask(self, ge: typing.Optional[builtins.float] = None, gt: typing.Optional[builtins.float] = None, le: typing.Optional[builtins.float] = None, lt: typing.Optional[builtins.float] = None, components: typing.Optional[typing.Sequence[builtins.str]] = None) -> NodeField:
        r"""
        Per-component 0/1 **mask** of this field against a value band — same
        structure as the field: same zones, same support, same components, only the
        values are rewritten (`1.0` inside the band, `0.0` outside). The result is
        therefore multipliable term by term with the field.
        
        Its sibling `select` extracts the passing *nodes* instead, and produces a
        `Mesh`.
        
        The band is set by the four comparison bounds `ge` (`≥`), `gt` (`>`),
        `le` (`≤`), `lt` (`<`). There is **no** AND across components: each value
        stands on its own. `components=None` tests every component; a `components`
        list tests only those, leaving the others at `1.0` (identity for the
        product), and a zone missing a listed component is left all-`1.0`.
        """

